{
  "name": "cursor-csv-middleware",
  "version": "1.0.0",
  "description": "Cursor CSV middleware for Salesforce - downloads ContentVersion files, parses them with DuckDB, and exposes paginated row-range API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/**/*.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.0-r.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.1.0"
  }
}
