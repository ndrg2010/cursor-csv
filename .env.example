PORT=3000
LOG_LEVEL=info

# Admin API key for org management endpoints (/v1/orgs)
ADMIN_API_KEY=your-admin-api-key-here

# Shared ECA (External Client App) credentials — same across all org installations
ECA_CLIENT_ID=your-eca-consumer-key
ECA_CLIENT_SECRET=your-eca-consumer-secret

# Salesforce API settings (shared across all orgs)
SF_API_VERSION=62.0
SF_FETCH_TIMEOUT_MS=30000

# Persistent data directory for org registry
DATA_DIR=./data

# Temporary file directory for CSV downloads
TMP_DIR=./tmp

# Session / TTL
CSV_TTL_SECONDS=900
MAX_CONCURRENT_SESSIONS=10
MAX_ROW_FETCH=2000
MAX_CSV_SIZE_BYTES=104857600

# Memory budget: MAX_CSV_SIZE_BYTES * MAX_CONCURRENT_SESSIONS * ~2 (DuckDB overhead)
# should stay under your container memory limit (docker-compose default: 4GB).
# Defaults: 100MB * 10 * 2 = ~2GB, leaving headroom for Node.js and OS.

# Platform Event callback (publishes to the originating org when a session completes)
CALLBACK_ENABLED=true
CALLBACK_PLATFORM_EVENT=CursorBatch_Coordinator__e
